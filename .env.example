NODE_ENV=development
PORT=3000
APP_NAME="Auth Starter"

# PostgreSQL (matches docker-compose.yml). For MySQL use mysql://user:pass@host:3306/db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_starter?schema=public"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_EXPIRES_IN=1d
COOKIE_SECRET="replace-me-with-another-32-plus-random-characters"

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: only needed if you send email with src/utils/send-otp.ts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Auth Starter <no-reply@example.com>"
